  "cards": [
    {
      "dot": "violet",
      "title": "Component contract",
      "items": [
        "plan(ctx, entry) \u2192 changes + new entry, or skip with reason",
        "apply / restore / check(ctx, entry)",
        "Every component reads colours from the active variant"
      ]
    },
    {
      "dot": "amber",
      "title": "Failure isolation",
      "items": [
        "claude settings not plain JSON \u2192 abort before any write",
        "font, windows-terminal, fish failures \u2192 warn, skip, continue",
        "State saved after each component, so it always matches reality"
      ]
    },
    {
      "dot": "rose",
      "title": "Second writer",
      "items": [
        "Background sky job (conf.d) rewrites only backgroundImage, about 8 times a month",
        "flock shared with the installer; atomic write after a hash re-check",
        "windows-terminal treats all 8 sky names as its own value"
      ]
    },
    {
      "dot": "cyan",
      "title": "Uninstall and doctor",
      "items": [
        "uninstall runs restore in reverse order: 4 \u2192 1",
        "doctor runs check() on each and exits 1 on any failure",
        "--only <component> limits install or uninstall to named components"
      ]
    }
  ]
